/* ── Window Root ── */
.window-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(56, 56, 56);
    color: rgb(200, 200, 200);
    font-size: 11px;
}

/* ── Toolbar ── */
.toolbar {
    flex-direction: row;
    height: 26px;
    background-color: rgb(48, 48, 48);
    border-bottom-color: rgb(38, 38, 38);
    border-bottom-width: 1px;
    padding-left: 4px;
    padding-right: 4px;
    flex-shrink: 0;
}

.toolbar-button {
    height: 20px;
    font-size: 11px;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 3px;
    margin-right: 2px;
}

.toolbar-title {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-grow: 1;
    padding-right: 8px;
    color: rgb(220, 220, 220);
}

/* ── Body ── */
.body {
    flex-grow: 1;
    flex-direction: row;
    overflow: hidden;
}

/* ── Columns ── */
.column {
    flex-direction: column;
    background-color: rgb(56, 56, 56);
}

.column-left {
    flex-basis: 260px;
    min-width: 180px;
    max-width: 380px;
}

.column-center {
    flex-grow: 1;
    min-width: 280px;
}

.column-right {
    flex-basis: 320px;
    min-width: 240px;
    max-width: 500px;
}

.column-header {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-bottom-color: rgb(38, 38, 38);
    border-bottom-width: 1px;
    min-height: 22px;
    flex-shrink: 0;
}

.column-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(210, 210, 210);
    flex-grow: 1;
}

.column-footer {
    flex-direction: row;
    padding: 4px 6px;
    border-top-color: rgb(38, 38, 38);
    border-top-width: 1px;
    justify-content: flex-end;
    flex-shrink: 0;
}

/* ── Divider ── */
.divider {
    width: 1px;
    background-color: rgb(38, 38, 38);
    flex-shrink: 0;
}

/* ── Route List ── */
.route-list-view {
    flex-grow: 1;
}

.search-field {
    flex-grow: 0;
    width: 140px;
}

.empty-hint {
    padding: 12px;
    color: rgb(120, 120, 120);
    -unity-text-align: middle-center;
}

/* ── Inspector ── */
.inspector-scroll {
    flex-grow: 1;
}

.inspector-section {
    padding: 5px 8px;
    border-bottom-color: rgb(46, 46, 46);
    border-bottom-width: 1px;
    flex-shrink: 0;
}

.section-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(170, 200, 230);
    padding-bottom: 3px;
    margin-bottom: 3px;
    border-bottom-color: rgb(66, 66, 66);
    border-bottom-width: 1px;
}

.inspector-field {
    margin-bottom: 1px;
}

.dropdown-container {
    margin-bottom: 4px;
}

.danger-button {
    background-color: rgb(140, 50, 50);
    color: white;
    font-size: 11px;
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
}

.danger-button:hover {
    background-color: rgb(170, 60, 60);
}

/* ── Tags ── */
.tags-container {
    flex-direction: row;
    flex-wrap: wrap;
}

/* ── Pipeline Content ── */
.tab-content {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

/* ── Interceptor Groups ── */
.interceptor-group {
    flex-direction: column;
    flex-grow: 1;
    padding: 4px 6px;
    overflow: hidden;
}

.interceptor-list {
    flex-grow: 1;
}

.add-button {
    height: 20px;
    font-size: 11px;
    background-color: rgb(60, 80, 60);
    color: rgb(180, 210, 180);
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 2px;
    flex-shrink: 0;
}

.add-button:hover {
    background-color: rgb(70, 100, 70);
}

/* ── Interceptor Item ── */
#interceptor-kind {
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

#interceptor-drag-handle {
    cursor: move;
    -unity-text-align: middle-center;
    opacity: 0.6;
}

#interceptor-drag-handle:hover {
    opacity: 1;
    color: rgb(160, 160, 160);
}

#interceptor-delete {
    border-width: 0;
}

#interceptor-delete:hover {
    background-color: rgb(200, 60, 60);
}
