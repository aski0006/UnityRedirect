<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xmlns:engine="UnityEngine.UIElements"
>
    <ui:VisualElement class="window-root">
        <!-- Toolbar -->
        <ui:Toolbar class="toolbar">
            <ui:ToolbarButton text="Refresh" name="refresh-button" class="toolbar-button" />
            <ui:ToolbarButton text="Create Route" name="create-route-button" class="toolbar-button" />
            <ui:ToolbarButton text="Open Folder" name="open-folder-button" class="toolbar-button" />
            <ui:ToolbarSpacer />
            <ui:Label text="Route Navigator" class="toolbar-title" />
        </ui:Toolbar>

        <!-- Main Content -->
        <ui:VisualElement class="main-content">
            <!-- Left Panel: Route List -->
            <ui:VisualElement class="panel panel-left" name="route-list-panel">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="Routes" class="panel-title" />
                    <ui:ToolbarSearchField name="route-search-field" class="search-field" />
                </ui:VisualElement>
                <ui:ListView
                    name="route-list-view"
                    class="route-list-view"
                    selection-type="Single"
                    show-fold-icon="false"
                    reorderable="false"
                />
                <ui:Label name="route-list-empty" class="empty-hint" text="No routes defined." />
            </ui:VisualElement>

            <!-- Resizer -->
            <ui:VisualElement class="resizer" name="left-resizer" />

            <!-- Center Panel: Inspector -->
            <ui:VisualElement class="panel panel-center" name="inspector-panel">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="Route Inspector" class="panel-title" />
                    <ui:Button text="Delete" name="delete-route-button" class="danger-button" />
                </ui:VisualElement>

                <!-- Type Selector -->
                <ui:VisualElement class="inspector-section">
                    <ui:Label text="Data Type" class="section-label" />
                    <ui:VisualElement name="type-dropdown-container" class="dropdown-container" />
                </ui:VisualElement>

                <!-- Basic Info -->
                <ui:VisualElement class="inspector-section">
                    <ui:Label text="Basic Info" class="section-label" />
                    <ui:TextField label="Route ID" name="route-id-field" class="inspector-field" />
                    <ui:TextField label="Display Name" name="display-name-field" class="inspector-field" />
                    <ui:TextField label="Description" name="description-field" class="inspector-field" multiline="true" />
                </ui:VisualElement>

                <!-- Target -->
                <ui:VisualElement class="inspector-section">
                    <ui:Label text="Target" class="section-label" />
                    <ui:EnumField label="Target Type" name="target-type-field" class="inspector-field" />
                    <ui:EnumField label="Load Mode" name="load-mode-field" class="inspector-field" />
                    <ui:ObjectField label="Scene Asset" name="scene-asset-field" class="inspector-field" type="UnityEditor.SceneAsset, UnityEditor" />
                    <ui:TextField label="Scene Path" name="scene-path-field" class="inspector-field" />
                    <ui:ObjectField label="Direct Reference" name="direct-reference-field" class="inspector-field" type="UnityEngine.GameObject, UnityEngine" />
                    <ui:ObjectField label="Prefab Reference" name="prefab-reference-field" class="inspector-field" type="UnityEngine.GameObject, UnityEngine" />
                    <ui:Toggle label="Unload Previous" name="unload-previous-toggle" class="inspector-field" />
                </ui:VisualElement>

                <!-- Tags -->
                <ui:VisualElement class="inspector-section">
                    <ui:Label text="Tags" class="section-label" />
                    <ui:VisualElement name="tags-container" class="tags-container" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Resizer -->
            <ui:VisualElement class="resizer" name="center-resizer" />

            <!-- Right Panel: Pipeline / Graph Tabs -->
            <ui:VisualElement class="panel panel-right" name="pipeline-panel">
                <ui:Toolbar class="panel-tabs">
                    <ui:ToolbarButton text="Pipeline" name="tab-pipeline" class="tab-button tab-active" />
                    <ui:ToolbarButton text="Graph" name="tab-graph" class="tab-button" />
                </ui:Toolbar>

                <!-- Pipeline Content -->
                <ui:VisualElement name="pipeline-content" class="tab-content">
                    <ui:Label text="Global Interceptors" class="section-label" />
                    <ui:ListView
                        name="global-interceptor-list"
                        class="interceptor-list"
                        selection-type="Single"
                    />
                    <ui:Button text="+ Add Global Interceptor" name="add-global-interceptor-button" class="add-button" />

                    <ui:Label text="Typed Interceptors" class="section-label" />
                    <ui:ListView
                        name="typed-interceptor-list"
                        class="interceptor-list"
                        selection-type="Single"
                    />
                    <ui:Button text="+ Add Typed Interceptor" name="add-typed-interceptor-button" class="add-button" />
                </ui:VisualElement>

                <!-- Graph Content -->
                <ui:VisualElement name="graph-content" class="tab-content" style="display: none;">
                    <ui:Label text="Route Graph (coming soon)" class="empty-hint" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
