<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
>
    <ui:VisualElement class="window-root">
        <!-- Toolbar -->
        <uie:Toolbar class="toolbar">
            <uie:ToolbarButton text="Refresh" name="refresh-button" class="toolbar-button" />
            <uie:ToolbarButton text="Create Route" name="create-route-button" class="toolbar-button" />
            <uie:ToolbarButton text="Init Assets" name="init-assets-button" class="toolbar-button" />
            <uie:ToolbarButton text="Locate Core" name="locate-core-button" class="toolbar-button locate-button" />
            <uie:ToolbarButton text="Locate Registry" name="locate-registry-button" class="toolbar-button locate-button" />
            <uie:ToolbarSpacer />
            <ui:Label text="Route Navigator" class="toolbar-title" />
        </uie:Toolbar>

        <!-- Three-Column Resizable Body -->
        <ui:VisualElement name="body-container" class="body">
            <!-- Columns are wrapped in TwoPaneSplitView programmatically in BuildUI -->
            <!-- Column 1: Route List -->
            <ui:VisualElement name="column-left" class="column column-left">
                <ui:VisualElement class="column-header">
                    <ui:Label text="Routes" class="column-title" />
                    <uie:ToolbarSearchField name="route-search-field" class="search-field" />
                </ui:VisualElement>
                <ui:ListView
                    name="route-list-view"
                    class="route-list-view"
                    selection-type="Single"
                    show-fold-icon="false"
                    reorderable="false"
                />
                <ui:Label name="route-list-empty" class="empty-hint" text="No routes defined." />
            </ui:VisualElement>

            <!-- Column 2: Route Inspector -->
            <ui:VisualElement name="column-center" class="column column-center">
                <!-- Empty placeholder when no routes exist -->
                <ui:VisualElement name="empty-placeholder" class="empty-placeholder">
                    <ui:Label text="No Routes Defined" class="empty-placeholder-title" />
                    <ui:Label text="Create a Route Definition to start configuring navigation." class="empty-placeholder-desc" />
                    <ui:Button text="Create Route" name="empty-create-route-button" class="empty-placeholder-button" />
                </ui:VisualElement>

                <ui:ScrollView name="inspector-scroll" class="inspector-scroll">
                    <ui:VisualElement class="inspector-section">
                        <ui:Label text="Route Data Type" class="section-label" />
                        <ui:VisualElement name="type-dropdown-container" class="dropdown-container" />
                    </ui:VisualElement>

                    <ui:VisualElement class="inspector-section">
                        <ui:Label text="Basic Info" class="section-label" />
                        <ui:TextField label="Route ID" name="route-id-field" class="inspector-field" />
                        <ui:TextField label="Display Name" name="display-name-field" class="inspector-field" />
                        <ui:TextField label="Description" name="description-field" class="inspector-field" multiline="true" />
                    </ui:VisualElement>

                    <ui:VisualElement class="inspector-section">
                        <ui:Label text="Target" class="section-label" />
                        <uie:EnumField label="Target Type" name="target-type-field" class="inspector-field" />
                        <uie:EnumField label="Load Mode" name="load-mode-field" class="inspector-field" />
                        <uie:ObjectField label="Scene Asset" name="scene-asset-field" class="inspector-field" type="UnityEditor.SceneAsset, UnityEditor" />
                        <ui:TextField label="Scene Path" name="scene-path-field" class="inspector-field" />
                        <uie:ObjectField label="Direct Reference" name="direct-reference-field" class="inspector-field" type="UnityEngine.GameObject, UnityEngine" />
                        <uie:ObjectField label="Prefab Reference" name="prefab-reference-field" class="inspector-field" type="UnityEngine.GameObject, UnityEngine" />
                        <ui:Toggle label="Unload Previous" name="unload-previous-toggle" class="inspector-field" />
                    </ui:VisualElement>

                    <ui:VisualElement class="inspector-section">
                        <ui:Label text="Tags (comma-separated)" class="section-label" />
                        <ui:TextField name="tags-field" class="inspector-field" />
                    </ui:VisualElement>

                    <ui:VisualElement class="inspector-section">
                        <ui:Label text="Navigation Event" class="section-label" />
                        <ui:VisualElement name="unity-event-container" class="inspector-field" />
                    </ui:VisualElement>
                </ui:ScrollView>

                <!-- Bottom toolbar: delete + locate -->
                <ui:VisualElement class="column-footer">
                    <ui:Button text="Locate Define" name="locate-define-button" class="locate-button" />
                    <ui:Button text="Delete Route" name="delete-route-button" class="danger-button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Column 3: Pipeline -->
            <ui:VisualElement name="column-right" class="column column-right">
                <ui:VisualElement class="column-header">
                    <ui:Label text="Pipeline" class="column-title" />
                </ui:VisualElement>

                <ui:VisualElement name="pipeline-content" class="tab-content">
                    <ui:VisualElement class="interceptor-group">
                        <ui:Label text="Interceptor Pipeline" class="section-label" />
                        <ui:ListView
                            name="unified-interceptor-list"
                            class="interceptor-list"
                            selection-type="Single"
                            reorderable="true"
                        />
                        <uie:ToolbarButton text="+ Add Interceptor" name="add-interceptor-button" class="add-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
